# Backend Environment Variables
PORT=3001
NODE_ENV=development

# Google Gemini API Key (required for resume analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://user:password@localhost:5432/jobfit

# Embedding model (uses Gemini API key above)
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# Score weights (must sum to 1.0)
SCORE_WEIGHT_SEMANTIC=0.35
SCORE_WEIGHT_LLM=0.45
SCORE_WEIGHT_SKILL=0.20
