# Backend Environment Variables
PORT=3001
NODE_ENV=development

# Google Gemini API Key (required for resume analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Comma-separated browser origins permitted to call this API
CORS_ORIGINS=http://localhost:3000

# Per-IP API request budget
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=30

# Keep false unless authenticated, user-owned records and deletion policies exist
PERSIST_ANALYSES=false

# Optional PostgreSQL + pgvector for authenticated persistence deployments
DATABASE_URL=

# Embedding model (uses Gemini API key above)
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768

# Score weights (must sum to 1.0)
SCORE_WEIGHT_SEMANTIC=0.35
SCORE_WEIGHT_LLM=0.45
SCORE_WEIGHT_SKILL=0.20
